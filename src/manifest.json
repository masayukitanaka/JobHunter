{
    "manifest_version": 3,
    "name": "JobHunter",
    "description": "求人応募フォームへの自動入力とAI入力支援",
    "version": "0.0.1",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "JobHunter"
    },
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Alt + Shift + L"
        }
      }
    }
  }
